# N8N Configuration
DOCKER_IMAGE=docker.n8n.io/n8nio/n8n:latest
CONTAINER_NAME=n8n-container
N8N_PORT=5677
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
NODE_ENV=production
TZ=Asia/Kolkata

# Cloudflared Configuration
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARED_CONTAINER_NAME=cloudflared-tunnel
CLOUDFLARED_TOKEN=your-cloudflare-tunnel-token-here

# Docker Configuration
RESTART_POLICY=unless-stopped

# Profiles (uncomment to enable cloudflared tunnel)
# COMPOSE_PROFILES=tunnel
